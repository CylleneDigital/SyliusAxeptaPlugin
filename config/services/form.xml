<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <!--
            The `type` attribute is an invariant: it selects this form for payment methods whose
            gateway is `axepta`, including those already in the database.
        -->
        <service id="cyllene_digital_sylius_axepta.form.type.gateway_configuration"
                 class="CylleneDigital\SyliusAxeptaPlugin\Form\Type\AxeptaGatewayConfigurationType">
            <tag name="sylius.gateway_configuration_type" type="axepta" label="Axepta - BNP Paribas" />
            <tag name="form.type" />
        </service>
    </services>
</container>

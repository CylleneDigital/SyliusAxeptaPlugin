DATABASE_URL=mysql://root:root@127.0.0.1/cyllene_digital_sylius_axepta_plugin_%kernel.environment%

# Payment request commands are handled within the request rather than queued: without this the
# functional notification tests would see a 200 response and an unchanged payment, the message
# waiting in a queue nobody consumes.
SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_DSN=sync://
SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_FAILED_DSN=sync://
